/* ============ 10. SELF TEST (จำลองเกมบอทล้วน ไม่เกี่ยวกับ UI) ============ */
function simGame(n,diff,sd){
 const chars=shuffle(CHL),pl=[];for(let i=0;i<n;i++)pl.push({name:"P"+i,char:chars[i],bot:true});
 const G=newGame({players:pl,diff:diff,seed:sd*7919+n});
 let steps=0,bad=0;
 while(!G.over&&steps++<6000){
  const p=curP(G),pn=botPlan(G,p);
  let r=apply(G,Object.assign({pid:p.id},pn.a));
  if(!r.ok){bad++;r=apply(G,{t:"end",pid:p.id});if(!r.ok){bad+=100;break}}
  RES.forEach(k=>{if(G.res[k]<0||G.res[k]>12)bad+=1000});
  if(G.storm<0||G.storm>8)bad+=1000;
  if(!connected(G.closed))bad+=1000;
 }
 if(!G.over)bad+=500;
 return{G:G,bad:bad};
}
function runTests(){
 const out=[],ok=(c,m)=>out.push((c?"ผ่าน ":"ล้มเหลว ")+m);
 try{
  ok(Object.keys(LOC).length===13,"13 สถานที่");ok(EDGES.length===19,"เส้นทาง 19 เส้น");ok(connected([]),"กราฟเชื่อมถึงกันครบ");
  ok(TREASURE.length===12&&STORMS.length===16,"การ์ดสมบัติ 12 / พายุ 16");
  const G=newGame({players:[{name:"A",char:"eng"},{name:"B",char:"cap"}],diff:"normal",seed:5});
  const p=G.players[0];G.res={wood:3,iron:0,crystal:1,rations:0};p.loc="LN";
  ok(!!check(G,p,"repair",{}),"ทรัพยากรไม่พอถูกปฏิเสธ");
  ok(check(G,p,"repair",{rEng:"crystal"})==="","วิศวกรลดคริสตัล 1 แล้วจุดประภาคารเหนือได้");
  const r=apply(G,{t:"repair",pid:0,rEng:"crystal"});
  ok(r.ok&&G.lit.LN&&G.res.wood===0&&G.res.crystal===0,"จ่ายทรัพยากรถูกต้องและไฟติด");
  ok(!!check(G,p,"repair",{}),"ห้ามจุดซ้ำ");
  ok(!!check(G,G.players[0],"move",{to:"IM"}),"ห้ามเดินข้ามเส้นที่ไม่เชื่อม");
  const G2=newGame({players:[{name:"A",char:"sur"},{name:"B",char:"cap"}],diff:"normal",seed:6});
  G2.players[0].loc="EF";apply(G2,{t:"gather",pid:0});ok(G2.res.wood===5,"นักเอาชีวิตรอดเก็บครั้งแรกได้ 3");
  apply(G2,{t:"gather",pid:0});ok(G2.res.wood===7,"เก็บครั้งที่สองได้ 2");
  let tot=0,bad=0,wins=0;const lines=[];
  [2,3,4,5,6].forEach(n=>["easy","normal","hard"].forEach(d=>{let w=0;for(let s=1;s<=6;s++){const x=simGame(n,d,s);tot++;bad+=x.bad;if(x.G.over&&x.G.over.win){w++;wins++}}lines.push(n+" คน/"+d+": ชนะ "+w+"/6")}));
  ok(bad===0,"จำลอง "+tot+" เกม ไม่พบการละเมิดกติกา (bad="+bad+")");
  out.push("บอทชนะ "+wins+"/"+tot+" เกม");lines.forEach(l=>out.push(l));
 }catch(e){out.push("ล้มเหลว (exception): "+e.message)}
 panel(out.join("\n"),"ผลทดสอบระบบ (จำลองเกมบอทเท่านั้น ไม่ใช่การทดสอบออนไลน์/มือถือ)");
}
