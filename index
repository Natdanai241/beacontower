<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>THE LAST BEACON: THE FOUR LIGHTS</title>
<style>
:root{--night:#0a1030;--teal:#1b8a8f;--parch:#f0e1b8;--parch2:#d9c28a;--gold:#e8b53c;--cyan:#6fe8ff;--violet:#8e5cff;--ink:#2a1d0e;--danger:#e0525c}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:var(--night);color:var(--parch);font-family:"Sarabun","Noto Sans Thai",Tahoma,sans-serif}
body{background:radial-gradient(ellipse at 50% 0%,#1d3a7a 0%,var(--night) 70%)}
#fx{position:fixed;inset:0;pointer-events:none;z-index:20}
.screen{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:16px;z-index:1;overflow-y:auto}
.screen.active{display:flex}
h1.title{font-size:clamp(26px,6vw,52px);letter-spacing:2px;text-align:center;color:var(--gold);text-shadow:0 0 24px rgba(232,181,60,.6),0 3px 0 #5a3d08}
h1.title small{display:block;font-size:.4em;color:var(--cyan);letter-spacing:6px;margin-top:6px}
h2{color:var(--gold);text-align:center}
.btn{background:linear-gradient(#2a6f8f,#134a66);color:#fff;border:2px solid var(--gold);border-radius:12px;padding:12px 22px;font:inherit;font-size:17px;cursor:pointer;min-width:200px;box-shadow:0 4px 0 #0a2a3a,0 0 14px rgba(111,232,255,.25)}
.btn:active{transform:translateY(3px)}
.btn.off{opacity:.45;filter:grayscale(.6)}
.btn.sec{background:linear-gradient(#3a3560,#221f3d);border-color:var(--violet)}
.btn.small{min-width:0;padding:8px 12px;font-size:14px}
.panel{background:linear-gradient(var(--parch),var(--parch2));color:var(--ink);border-radius:14px;padding:14px;box-shadow:0 8px 24px rgba(0,0,0,.5);max-width:720px;width:100%}
.row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;align-items:center;margin:6px 0}
.seg button{background:#e9d9a8;border:2px solid #8a6a2a;border-radius:8px;padding:8px 14px;font:inherit;color:var(--ink);cursor:pointer}
.seg button.sel{background:var(--gold);font-weight:700}
input[type=text]{padding:10px;border-radius:8px;border:2px solid #8a6a2a;font:inherit;font-size:18px;text-align:center;width:170px}
#inRoom{text-transform:uppercase}
.charGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;width:100%;max-width:720px}
.charCard{background:#f6ebc9;border:3px solid transparent;border-radius:12px;padding:8px;text-align:center;cursor:pointer;color:var(--ink);font-size:12px}
.charCard.sel{border-color:var(--gold);box-shadow:0 0 14px var(--gold)}
.charCard.taken{opacity:.35;pointer-events:none}
.charCard svg{width:68px;height:68px}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#888;margin-right:6px}
.dot.on{background:#4ade80}.dot.off{background:#ef4444}.dot.re{background:#facc15}
#scr-game{padding:0;gap:0;justify-content:flex-start;align-items:stretch;overflow:hidden}
#topbar{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:5px 8px;background:rgba(8,14,40,.94);border-bottom:2px solid var(--gold);font-size:13px;flex:0 0 auto}
.chip{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.08);border-radius:10px;padding:2px 8px;white-space:nowrap}
.ic svg{width:18px;height:18px;display:block}
#stormTrack{display:flex;gap:2px}
#stormTrack i{width:11px;height:15px;border-radius:3px;background:#2b2150;border:1px solid #6a4aa0}
#stormTrack i.on{background:var(--violet);box-shadow:0 0 8px var(--violet)}
#stormTrack i.on.dg{background:var(--danger)}
#lhProg{display:flex;gap:4px}
#lhProg b{width:16px;height:16px;border-radius:50%;background:#333;border:2px solid #777}
#lhProg b.lit{background:var(--gold);box-shadow:0 0 10px var(--gold);border-color:#fff}
#mid{flex:1 1 auto;display:flex;min-height:0}
#mapWrap{flex:1 1 auto;position:relative;min-width:0}
#map{position:absolute;inset:0;width:100%;height:100%}
#side{flex:0 0 220px;background:rgba(8,14,40,.9);border-left:2px solid var(--teal);display:flex;flex-direction:column;min-height:0}
#players{padding:5px;display:flex;flex-direction:column;gap:3px;overflow-y:auto;max-height:55%}
.pl{display:flex;align-items:center;gap:6px;padding:3px 5px;border-radius:8px;background:rgba(255,255,255,.06);font-size:12px}
.pl.cur{outline:2px solid var(--gold);background:rgba(232,181,60,.15)}
#log{flex:1;overflow-y:auto;padding:5px;font-size:12px;line-height:1.35;border-top:1px solid var(--teal)}
#log div{margin-bottom:3px}
#bottom{flex:0 0 auto;background:rgba(8,14,40,.96);border-top:2px solid var(--gold);padding:5px 8px;padding-bottom:max(5px,env(safe-area-inset-bottom))}
#curInfo{font-size:12px;margin-bottom:4px;display:flex;gap:6px 10px;flex-wrap:wrap;align-items:center}
#curInfo .pv{width:26px;height:26px}
#curInfo .tag{background:rgba(111,232,255,.15);border-radius:8px;padding:1px 6px}
#actions{display:flex;gap:5px;flex-wrap:wrap}
#actions .btn{min-width:0;flex:1 1 80px;padding:8px 4px;font-size:14px}
#hint{font-size:12px;color:var(--cyan);min-height:16px;margin-top:3px}
#roomBadge{font-size:12px;color:var(--cyan)}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
.modal.active{display:flex}
.card{width:230px;height:320px;perspective:900px;margin:0 auto}
.card .in{position:relative;width:100%;height:100%;transition:transform .6s;transform-style:preserve-3d}
.card.flip .in{transform:rotateY(180deg)}
.card .f,.card .b{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:14px;border:4px solid var(--gold);padding:12px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center}
.card .b{background:repeating-linear-gradient(45deg,#1b2a66,#1b2a66 8px,#24357a 8px,#24357a 16px)}
.card .f{transform:rotateY(180deg);background:linear-gradient(var(--parch),var(--parch2));color:var(--ink)}
.card.storm .f{background:linear-gradient(#3a2470,#1c1040);color:#fff}
.card h3{font-size:18px}.card svg{width:110px;height:110px}.card p{font-size:14px}
#errPanel{position:fixed;left:8px;right:8px;bottom:8px;z-index:999;display:none;background:#4a0d14;color:#fff;border:2px solid var(--danger);border-radius:10px;padding:10px;font-size:13px}
#errPanel.show{display:block}
#errPanel pre{white-space:pre-wrap;font-size:11px;margin-top:4px;max-height:40vh;overflow:auto}
#toast{position:fixed;top:10px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.85);color:#fff;border:1px solid var(--gold);border-radius:10px;padding:8px 14px;z-index:998;display:none;max-width:90%;font-size:14px;text-align:center}
.tok{transition:transform .5s ease;pointer-events:none}
.tok.cur circle{animation:pu 1s infinite alternate}
@keyframes pu{from{stroke:#fff}to{stroke:#e8b53c;stroke-width:5}}
.hl{fill:none;stroke:#6fe8ff;stroke-width:4;stroke-dasharray:8 6;animation:dsh 1s linear infinite;pointer-events:none}
@keyframes dsh{to{stroke-dashoffset:-28}}
.wv{animation:wv 9s ease-in-out infinite alternate}
@keyframes wv{to{transform:translateX(30px)}}
.glow{opacity:0;transition:opacity .6s}
.glow.on{opacity:.9;animation:gl 2s ease-in-out infinite alternate}
@keyframes gl{to{opacity:.45}}
.ring{transform-box:fill-box;transform-origin:center;animation:rg 1.4s ease-out forwards;fill:none;stroke:#ffe27a;stroke-width:6}
@keyframes rg{from{transform:scale(.3);opacity:1}to{transform:scale(6);opacity:0}}
.beam{stroke:#ffe27a;stroke-width:8;stroke-linecap:round;filter:url(#glow);stroke-dasharray:900;stroke-dashoffset:900;animation:bm 1.6s ease forwards}
@keyframes bm{to{stroke-dashoffset:0}}
@media (max-width:760px){
#mid{flex-direction:column}
#side{flex:0 0 26%;border-left:0;border-top:2px solid var(--teal);flex-direction:row}
#players{max-height:none;flex:1}#log{border-top:0;border-left:1px solid var(--teal);flex:1}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="fx"></canvas>
<div id="toast"></div>

<section class="screen active" id="scr-menu">
  <h1 class="title">THE LAST BEACON<small>THE FOUR LIGHTS</small></h1>
  <p>เกมกระดานร่วมมือ 2–6 ผู้เล่น · ราว 25–40 นาที</p>
  <button class="btn" id="btnPlay">เริ่มเกม</button>
  <button class="btn sec" id="btnResume" style="display:none">เล่นเกมเดี่ยวต่อ</button>
  <button class="btn sec" id="btnRules">วิธีเล่น</button>
  <button class="btn sec" id="btnMusic">ดนตรี: เปิด</button>
  <button class="btn small sec" id="btnTest">ทดสอบระบบ (จำลองเกมบอท)</button>
</section>

<section class="screen" id="scr-mode">
  <h2>เลือกโหมดเกม</h2>
  <button class="btn" id="btnSolo">เดี่ยว / บอท</button>
  <button class="btn" id="btnOnline">ออนไลน์ P2P จริง</button>
  <button class="btn sec" data-back="scr-menu">ย้อนกลับ</button>
</section>

<section class="screen" id="scr-setup">
  <h2>ตั้งค่าเกมเดี่ยว</h2>
  <div class="panel">
    <p>จำนวนผู้เล่นทั้งหมด (คุณ + บอท)</p><div class="row seg" id="segCount"></div>
    <p>ความยากของบอท / เหตุการณ์</p><div class="row seg" id="segDiff"></div>
    <p id="roundsInfo" style="font-weight:700"></p>
    <p id="diffInfo" style="font-size:13px"></p>
  </div>
  <button class="btn" id="btnToChars">เลือกตัวละคร</button>
  <button class="btn sec" data-back="scr-mode">ย้อนกลับ</button>
</section>

<section class="screen" id="scr-chars">
  <h2>เลือกตัวละครของคุณ</h2>
  <div class="charGrid" id="charGrid"></div>
  <p id="charDesc" class="panel">แตะตัวละครเพื่อดูความสามารถ</p>
  <button class="btn" id="btnStart">เริ่มผจญภัย</button>
  <button class="btn sec" id="btnCharsBack">ย้อนกลับ</button>
</section>

<section class="screen" id="scr-lobby">
  <h2>ห้องรอออนไลน์</h2>
  <div class="panel">
    <div class="row">
      <input type="text" id="inName" maxlength="12" placeholder="ชื่อผู้เล่น">
      <input type="text" id="inRoom" maxlength="5" placeholder="รหัสห้อง 5 ตัว">
    </div>
    <div class="row">
      <button class="btn small" id="btnCreate">สร้างห้อง</button>
      <button class="btn small" id="btnJoin">เข้าร่วมห้อง</button>
      <button class="btn small sec" id="btnTurn">ตั้งค่า TURN</button>
    </div>
    <p id="netStatus"></p>
    <p id="roomCode" style="font-size:30px;text-align:center;font-weight:700;letter-spacing:6px"></p>
    <div class="row"><button class="btn small sec" id="btnCopyLink" style="display:none">คัดลอกลิงก์เชิญ</button></div>
    <div id="lobbyList"></div>
    <p style="margin-top:6px;font-size:13px">เลือกตัวละคร:</p>
    <div class="charGrid" id="lobbyChars" style="margin-top:6px"></div>
    <p style="font-size:12px;margin-top:8px">หมายเหตุ: ใช้ WebRTC ผ่านเซิร์ฟเวอร์สัญญาณ PeerJS สาธารณะ และ STUN เท่านั้น P2P ตรงอาจเชื่อมต่อไม่ได้บนเครือข่ายมือถือ/Wi-Fi ที่จำกัด ต้องตั้งค่า TURN เอง (ปุ่ม ตั้งค่า TURN) จึงจะเสถียรขึ้น หากโฮสต์หลุด เกมจะหยุด (ไม่มีการย้ายโฮสต์) โฮสต์เปิดห้องรหัสเดิมด้วยชื่อเดิมเพื่อกู้เกมได้</p>
  </div>
  <button class="btn" id="btnHostStart" style="display:none">เริ่มเกม (โฮสต์)</button>
  <button class="btn sec" id="btnLobbyBack">ย้อนกลับ</button>
</section>

<section class="screen" id="scr-game">
  <div id="topbar">
    <span class="chip">รอบ <b id="tRound">1</b>/<b id="tMax">8</b></span>
    <span class="chip">พายุ <span id="stormTrack"></span></span>
    <span class="chip">ประภาคาร <span id="lhProg"></span></span>
    <span class="chip"><span class="ic" data-i="wood"></span>ไม้ <b id="rWood">0</b></span>
    <span class="chip"><span class="ic" data-i="iron"></span>เหล็ก <b id="rIron">0</b></span>
    <span class="chip"><span class="ic" data-i="crystal"></span>คริสตัล <b id="rCrystal">0</b></span>
    <span class="chip"><span class="ic" data-i="rations"></span>เสบียง <b id="rRations">0</b></span>
    <span id="roomBadge"></span>
    <button class="btn small sec" id="btnHistory">สรุปรอบ</button>
    <button class="btn small sec" id="btnMusic2">ดนตรี</button>
    <button class="btn small sec" id="btnRestart">เริ่มใหม่</button>
  </div>
  <div id="mid">
    <div id="mapWrap"><svg id="map" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid meet"></svg></div>
    <aside id="side"><div id="players"></div><div id="log"></div></aside>
  </div>
  <div id="bottom">
    <div id="curInfo"></div>
    <div id="actions">
      <button class="btn" data-act="move">เดิน</button>
      <button class="btn" data-act="gather">เก็บของ</button>
      <button class="btn" data-act="explore">สำรวจ</button>
      <button class="btn" data-act="repair">ซ่อม/จุดไฟ</button>
      <button class="btn" data-act="rescue">ช่วยคน</button>
      <button class="btn" data-act="final">จุดไฟสุดท้าย</button>
      <button class="btn" data-act="special">พิเศษ</button>
      <button class="btn sec" data-act="end">จบเทิร์น</button>
    </div>
    <div id="hint"></div>
  </div>
</section>

<section class="screen" id="scr-end">
  <h1 class="title" id="endTitle"></h1>
  <div class="panel" id="endBody"></div>
  <button class="btn" id="btnNewGame">เกมใหม่</button>
  <button class="btn sec" id="btnEndMenu">เมนูหลัก</button>
</section>

<div class="modal" id="mdCard"><div style="text-align:center">
  <div class="card" id="cardEl"><div class="in">
    <div class="b"></div>
    <div class="f"><h3 id="cardTitle"></h3><div id="cardArt"></div><p id="cardText"></p></div>
  </div></div>
  <button class="btn" id="btnCardOk" style="margin-top:12px">ตกลง</button>
</div></div>

<div class="modal" id="mdConfirm"><div class="panel" style="text-align:center">
  <p id="confirmText"></p>
  <div class="row"><button class="btn small" id="btnConfirmYes">ยืนยัน</button><button class="btn small sec" id="btnConfirmNo">ยกเลิก</button></div>
</div></div>

<div class="modal" id="mdChoose"><div class="panel" style="text-align:center">
  <p id="chooseTitle" style="font-weight:700"></p>
  <div class="row" id="chooseBtns"></div>
</div></div>

<div class="modal" id="mdHistory"><div class="panel">
  <h2 style="color:var(--ink)">สรุปรอบ</h2>
  <div id="histBody" style="max-height:50vh;overflow-y:auto;font-size:14px"></div>
  <button class="btn small" id="btnHistClose" style="margin-top:8px">ปิด</button>
</div></div>

<div class="modal" id="mdRules"><div class="panel">
  <h2 style="color:var(--ink)">วิธีเล่น</h2>
  <div id="rulesBody" style="max-height:55vh;overflow-y:auto;font-size:14px"></div>
  <button class="btn small" id="btnRulesClose" style="margin-top:8px">ปิด</button>
</div></div>

<div id="errPanel"><b id="errTitle">เกิดข้อผิดพลาด</b> <button class="btn small" id="btnErrClose">ปิด</button><pre id="errText"></pre></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js"></script>
<script>
"use strict";
/* ============ 0. UTIL / STATE ============ */
const $=id=>document.getElementById(id);
const RM=!!(window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches);
const S={mode:null,G:null,myId:0,cfg:null,busy:0,seen:0,gid:null,cq:[],screen:"scr-menu",hintUntil:0,endTimer:null,endShown:false,ask:0,bt:null,cardOpen:false,cardT:null,setup:{count:2,diff:"normal",char:null}};
const NET={peer:null,sid:0,isHost:false,code:"",name:"",hostConn:null,seats:[],lobby:[],joined:false,seen:{},hb:null,rt:null,jt:null,tries:0,lastHost:0,lostSid:-1};
function panel(msg,title){$("errTitle").textContent=title||"เกิดข้อผิดพลาด";$("errText").textContent=String(msg);$("errPanel").classList.add("show")}
window.addEventListener("error",e=>panel((e.message||"unknown")+" @"+(e.lineno||"?")));
window.addEventListener("unhandledrejection",e=>panel(e.reason&&e.reason.message?e.reason.message:e.reason));
function el(tag,cls,txt){const e=document.createElement(tag);if(cls)e.className=cls;if(txt!==undefined)e.textContent=txt;return e}
function clear(e){while(e.firstChild)e.removeChild(e.firstChild)}
function go(id){document.querySelectorAll(".screen").forEach(s=>s.classList.toggle("active",s.id===id));S.screen=id}
function cleanName(s){return String(s||"").replace(/[\u0000-\u001f<>]/g,"").trim().slice(0,12)}
function uid(){return Math.random().toString(36).slice(2,10)}
function toast(m){const t=$("toast");t.textContent=m;t.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(()=>{t.style.display="none"},2600)}
function hint(m){$("hint").textContent=m;S.hintUntil=Date.now()+4500}
function ask(text,cb){$("confirmText").textContent=text;$("mdConfirm").classList.add("active");$("btnConfirmYes").onclick=()=>{$("mdConfirm").classList.remove("active");cb()};$("btnConfirmNo").onclick=()=>$("mdConfirm").classList.remove("active")}
function choose(title,opts,cb){$("chooseTitle").textContent=title;const b=$("chooseBtns");clear(b);opts.forEach(o=>{const x=el("button","btn small",o.l);x.onclick=()=>{$("mdChoose").classList.remove("active");cb(o.v)};b.appendChild(x)});const c=el("button","btn small sec","ยกเลิก");c.onclick=()=>{$("mdChoose").classList.remove("active");S.ask=0};b.appendChild(c);$("mdChoose").classList.add("active")}
function loadSet(){try{return JSON.parse(localStorage.getItem("lb_set")||"{}")||{}}catch(e){return{}}}
function saveSet(o){try{localStorage.setItem("lb_set",JSON.stringify(Object.assign(loadSet(),o)))}catch(e){}}

/* RNG (seedable for tests) */
let _s=(Date.now()%2147483647)|0;
function rng(){_s=(_s+0x6D2B79F5)|0;let t=Math.imul(_s^(_s>>>15),1|_s);t=(t+Math.imul(t^(t>>>7),61|t))^t;return((t^(t>>>14))>>>0)/4294967296}
function seed(s){_s=s|0}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));const t=a[i];a[i]=a[j];a[j]=t}return a}

/* ============ NETWORK CONFIG ============
 signaling: PeerJS Cloud สาธารณะ (0.peerjs.com) เป็นค่าเริ่มต้น ใส่เซิร์ฟเวอร์ของตนเองได้ใน peerServer
   เช่น {host:"peer.example.com",port:443,path:"/",secure:true}
 TURN: ไม่ฝังรหัสผ่านในไฟล์ ใช้ปุ่ม "ตั้งค่า TURN" วาง JSON เช่น
   [{"urls":["turn:host:3478?transport=udp","turns:host:443?transport=tcp"],"username":"u","credential":"p"}]
   เก็บใน localStorage ของเบราว์เซอร์นั้นเท่านั้น */
const CFG={stun:[{urls:"stun:stun.l.google.com:19302"},{urls:"stun:global.stun.twilio.com:3478"}],peerServer:null};

/* ============ 1. DATA ============ */
const RES=["wood","iron","crystal","rations"];
const RN={wood:"ไม้",iron:"เหล็ก",crystal:"คริสตัล",rations:"เสบียง"};
const RID={wood:"rWood",iron:"rIron",crystal:"rCrystal",rations:"rRations"};
/* SL = ทะเลสาบวิญญาณ (Spirit Lake), LS = ประภาคารใต้ (Southern Lighthouse) */
const LOC={
HB:{n:"ท่าเรือกลาง",x:620,y:330,t:"harbor"},
EF:{n:"ป่ามรกต",x:640,y:140,t:"tree",res:"wood"},
