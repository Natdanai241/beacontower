function closeCard(){if(!S.cardOpen)return;clearTimeout(S.cardT);$("cardEl").classList.remove("flip");S.busy=Math.max(0,S.busy-1);S.cardOpen=false;setTimeout(nextCard,120)}
function showEnd(){
