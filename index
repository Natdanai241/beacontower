 else if(f.type==="card")queueCard("t",f.id,pl?pl.name:"");
 else if(f.type==="storm")queueCard("s",f.id,"");
 else if(f.type==="ignite"){sfx("ignite");ignite(f.loc)}
}
function queueCard(k,id,who){S.cq.push({k:k,id:id,who:who});if(!S.cardOpen)nextCard()}
function nextCard(){
 const c=S.cq.shift();if(!c){S.cardOpen=false;$("mdCard").classList.remove("active");schedBot();return}
 S.cardOpen=true;S.busy++;
