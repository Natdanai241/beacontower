function emit(G,type,d){d=d||{};d.type=type;d.n=++G.fxN;G.fx.push(d);if(G.fx.length>24)G.fx.shift()}
function lg(G,t){G.log.push({r:G.round,t:t});if(G.log.length>150)G.log.shift()}
function addR(G,k,n){const g=Math.max(0,Math.min(12,G.res[k]+n)-G.res[k]);G.res[k]+=g;return g}
function connected(closed){const seen={HB:1};const q=["HB"];let n=1;while(q.length){const x=q.shift();ADJ[x].forEach(y=>{if(seen[y]||closed.indexOf(ek(x,y))>=0)return;seen[y]=1;n++;q.push(y)})}return n===13}
function path(G,a,b){if(a===b)return[];const prev={};prev[a]=null;const q=[a];while(q.length){const x=q.shift();for(const y of ADJ[x]){if(y in prev||isClosed(G,x,y))continue;prev[y]=x;if(y===b){const r=[];let c=b;while(c!==a){r.unshift(c);c=prev[c]}return r}q.push(y)}}return null}
function newGame(cfg){
 const sd=cfg.seed||Math.floor(Math.random()*2e9);seed(sd);
 const n=cfg.players.length,d=cfg.diff||"normal";
 const res={wood:2,iron:2,crystal:1,rations:3};
 if(d==="easy"){res.wood=4;res.iron=4;res.crystal=3;res.rations=4}
 if(d==="hard"){res.rations=2;res.crystal=0}
 const ids=shuffle(["AV","MF","AR"]);const surv={};surv[ids[0]]="vis";surv[ids[1]]="vis";surv[ids[2]]="hid";
 const G={gid:uid(),started:true,diff:d,n:n,round:1,max:MAXR[n],storm:0,res:res,lit:{},surv:surv,closed:[],fog:false,
  players:cfg.players.map((p,i)=>({id:i,name:p.name,char:p.char,bot:!!p.bot,loc:"HB",ap:2,pen:0,free:0,u:{},online:true,downAt:0})),
  cur:0,tDeck:shuffle(TREASURE.map(t=>t.id)),tDisc:[],sDeck:shuffle(STORMS.map(s=>s.id)),sDisc:[],
  toolkit:0,ward:0,guard:null,dark:false,cancelArmed:false,mageUsed:false,peek:null,peekR:0,pend:null,goalLH:null,
  log:[],hist:[],fx:[],fxN:0,over:null,rescued:0};
 lg(G,"ภารกิจเริ่มต้น! จุดประภาคารทั้งสี่ แล้วกลับมาจุดประภาคารสุดท้ายที่ท่าเรือกลาง");
 newRound(G);
 return G;
}
function newRound(G){G.cur=0;G.players.forEach(p=>{p.ap=Math.max(0,2-p.pen);p.pen=0;p.u={}});lg(G,"— รอบที่ "+G.round+" เริ่มต้น —")}
function pay(p,kind,test){
 let src=null;
 if(kind==="move"){if(p.char==="cap"&&!p.u.move)src="cap";else if(p.free>0)src="tok"}
 else if(kind==="explore"&&p.char==="sco"&&!p.u.explore)src="sco";
 if(!src&&p.ap<1)return false;
 if(test)return true;
 if(src==="cap")p.u.move=1;else if(src==="tok")p.free--;else if(src==="sco")p.u.explore=1;else p.ap--;
 return true;
}
function lhCost(G,p,a){
 const cost=Object.assign({},LH[p.loc]);
 if(a.rEng){if(p.char!=="eng")return{ok:false,msg:"เฉพาะวิศวกรที่ลดต้นทุนได้"};if(!(cost[a.rEng]>0))return{ok:false,msg:"ลดทรัพยากรนั้นไม่ได้"};cost[a.rEng]--}
 if(a.rTool){if(G.toolkit<1)return{ok:false,msg:"ไม่มีชุดเครื่องมือโบราณ"};if(!(cost[a.rTool]>0))return{ok:false,msg:"ลดทรัพยากรนั้นไม่ได้"};cost[a.rTool]--}
