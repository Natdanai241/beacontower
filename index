  choose("แผนที่ลึกลับ: พายุถัดไป 1) "+(t[0]?SM[t[0]].n:"-")+"  2) "+(t[1]?SM[t[1]].n:"-")+" — สลับลำดับหรือไม่?",[{l:"คงเดิม",v:"0"},{l:"สลับลำดับ",v:"1"}],v=>{S.ask=0;dispatch({t:"mapOrder",swap:v==="1"})})}
 if(G.over&&!S.endTimer){sfx(G.over.win?"win":"lose");if(G.over.win)playWin();S.endTimer=setTimeout(showEnd,G.over.win?3400:900)}
}
function playFx(G,f){
 const pl=G.players[f.pid];
 if(f.type==="move")sfx("move");
 else if(f.type==="gather"){sfx("gather");burst(f.loc,"#6fe8ff")}
