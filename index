/* ============ 7. CONTROL ============ */
function dispatch(a){
 a.pid=S.myId;a.aid=uid();
 if(S.mode==="client"){
  if(NET.hostConn&&NET.hostConn.open&&NET.joined)safeSend(NET.hostConn,{t:"act",a:a});
  else{toast("ขาดการเชื่อมต่อกับโฮสต์ — ส่งคำสั่งไม่ได้");sfx("err")}
  return;
 }
 const r=apply(S.G,a);if(!r.ok){toast(r.msg);sfx("err");return}
 afterChange();
}
function persist(){
 try{const G=S.G;if(!G)return;
  if(S.mode==="solo"){if(G.over)localStorage.removeItem("lb_solo");else localStorage.setItem("lb_solo",JSON.stringify(G))}
  else if(S.mode==="host")localStorage.setItem("lb_host",JSON.stringify({code:NET.code,G:G}))}catch(e){}
}
function afterChange(){persist();if(S.mode==="host")broadcast();render();schedBot()}
function schedBot(){
 clearTimeout(S.bt);const G=S.G;
 if(!G||G.over||S.mode==="client"||S.mode===null)return;
 const p=curP(G);if(!p||!p.bot)return;
 S.bt=setTimeout(botTick,S.busy>0?500:(G.diff==="easy"?950:700));
}
function botTick(){
 const G=S.G;if(!G||G.over||S.mode==="client")return;
 const p=curP(G);if(!p.bot)return;
 if(S.busy>0||S.ask){schedBot();return}
 const pl=botPlan(G,p);
 if(pl.a.t!=="end")lg(G,"["+p.name+"] "+pl.why);
 let r=apply(G,Object.assign({pid:p.id},pl.a));
 if(!r.ok)r=apply(G,{t:"end",pid:p.id});
 afterChange();
}
function onAct(k){
 const G=S.G,p=me();if(!G||!p)return;
 if(G.over)return;
 if(G.players[G.cur]!==p){hint("ยังไม่ถึงตาของคุณ");sfx("err");return}
 if(k==="move"){hint(BTNDESC.move);return}
 if(k==="repair"){startRepair();return}
 if(k==="special"){startSpecial();return}
 const why=check(G,p,k,{});if(why){hint(why);sfx("err");return}
 dispatch({t:k});
}
function startRepair(){
 const G=S.G,p=me();
 if(LHS.indexOf(p.loc)<0||G.lit[p.loc]){hint(check(G,p,"repair",{})||"ซ่อมไม่ได้");sfx("err");return}
 const cost=LH[p.loc],keys=Object.keys(cost),a={t:"repair"};
 const opts=()=>keys.map(k=>({l:RN[k]+" ("+cost[k]+")",v:k}));
 const askEng=cb=>{if(p.char==="eng")choose("วิศวกร: เลือกทรัพยากรที่จะลดต้นทุนลง 1",opts(),v=>{a.rEng=v;cb()});else cb()};
 const askTool=cb=>{if(G.toolkit>0)choose("ชุดเครื่องมือโบราณ: ใช้ลดต้นทุน 1 หรือไม่",opts().concat([{l:"ไม่ใช้",v:""}]),v=>{if(v)a.rTool=v;cb()});else cb()};
 askEng(()=>askTool(()=>{const why=check(G,p,"repair",a);if(why){hint(why);sfx("err");return}dispatch(a)}));
}
function startSpecial(){
 const G=S.G,p=me();
 if(p.char!=="mag"){hint(CH[p.char].n+": "+CH[p.char].ab);return}
 const o=[{l:"ส่องพายุใบถัดไป (ฟรี)",v:"peek"}];
 if(!G.mageUsed&&!G.cancelArmed)o.push({l:"เตรียมยกเลิกผลร้ายพายุครั้งถัดไป (ครั้งเดียวต่อเกม)",v:"cancel"});
 choose("พลังจอมเวทพยากรณ์",o,v=>{const why=check(G,p,"special",{k:v});if(why){hint(why);return}dispatch({t:"special",k:v})});
}
function newSolo(){
 const c=S.cfg,others=shuffle(CHL.filter(x=>x!==c.char));
 const pl=[{name:loadSet().name||"คุณ",char:c.char,bot:false}];
 for(let i=1;i<c.count;i++)pl.push({name:"บอท "+i,char:others[i-1],bot:true});
 S.G=newGame({players:pl,diff:c.diff});S.mode="solo";S.myId=0;S.gid=null;go("scr-game");afterChange();
}
function restartGame(){
 if(S.mode==="solo"){newSolo();return}
 if(S.mode==="host"){
  const pl=NET.seats.map(s=>({name:s.name,char:s.char,bot:false}));
  S.G=newGame({players:pl,diff:"normal"});S.G.players.forEach((p,i)=>{p.online=NET.seats[i].online});S.gid=null;afterChange();return;
 }
 toast("เฉพาะโฮสต์เท่านั้นที่เริ่มเกมใหม่ได้ — รอโฮสต์");
}

/* ============ 8. NETWORK (PeerJS, host-authoritative) ============ */
const safeSend=(c,m)=>{try{if(c&&c.open)c.send(m)}catch(e){}};
function netMsg(t,err){const e=$("netStatus");e.textContent=t;e.style.color=err?"#a01020":"#134a66"}
function ice(){let t=[];try{t=JSON.parse(localStorage.getItem("lb_turn")||"[]")}catch(e){}return CFG.stun.concat(Array.isArray(t)?t:[])}
function peerOpts(){const o={config:{iceServers:ice()},debug:0};if(CFG.peerServer)Object.assign(o,CFG.peerServer);return o}
function rndCode(){const a="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";let s="";for(let i=0;i<5;i++)s+=a[Math.floor(Math.random()*a.length)];return s}
function closeNet(){
 NET.sid++;clearInterval(NET.hb);clearTimeout(NET.rt);clearTimeout(NET.jt);
 try{if(NET.peer)NET.peer.destroy()}catch(e){}
 NET.peer=null;NET.hostConn=null;NET.joined=false;
}
function leaveNet(){closeNet();NET.seats=[];NET.lobby=[];NET.isHost=false;if(S.mode==="host"||S.mode==="client"){S.mode=null;S.G=null;S.gid=null}clearTimeout(S.bt)}
function inviteLink(){return location.origin+location.pathname+"?room="+NET.code}
function pub(s){return{id:s.id,name:s.name,char:s.char,online:s.online}}
function broadcastLobby(){
 NET.lobby=NET.seats.map(pub);
 NET.seats.forEach(s=>{if(s.conn&&s.online)safeSend(s.conn,{t:"lobby",seats:NET.lobby,code:NET.code})});
 renderLobby();
}
function broadcast(){
 if(!NET.isHost)return;
 if(S.G){const v=viewOf(S.G);NET.seats.forEach(s=>{if(s.conn&&s.online)safeSend(s.conn,{t:"state",G:v})})}
 else broadcastLobby();
}
function renderLobby(){
 const list=$("lobbyList");clear(list);
 NET.lobby.forEach(s=>{const r=el("div");const d=el("span","dot "+(s.online?"on":"off"));r.appendChild(d);
  r.appendChild(el("span","",s.name+(s.id===0?" (โฮสต์)":"")+" — "+(s.char?CH[s.char].n:"ยังไม่เลือกตัวละคร")+" — "+(s.online?"ออนไลน์":"ออฟไลน์")));list.appendChild(r)});
 const mine=NET.lobby.find(s=>s.id===S.myId);
 const taken=new Set(NET.lobby.filter(s=>s.char&&s.id!==S.myId).map(s=>s.char));
 markGrid($("lobbyChars"),mine?mine.char:null,taken);
 const hs=$("btnHostStart");hs.style.display=NET.isHost?"":"none";
 const ready=NET.lobby.length>=2&&NET.lobby.every(s=>s.char&&s.online);
 hs.classList.toggle("off",!ready);
 $("roomCode").textContent=NET.code||"";$("btnCopyLink").style.display=NET.isHost&&NET.code?"":"none";
}
function pickChar(id){
 if(NET.isHost){const s=NET.seats[0];if(NET.seats.some(x=>x!==s&&x.char===id)){toast("ตัวละครนี้ถูกเลือกแล้ว");return}s.char=id;broadcastLobby()}
 else if(NET.joined)safeSend(NET.hostConn,{t:"pick",char:id});
 else toast("ยังไม่ได้เชื่อมต่อห้อง");
}
function seatOf(c){return NET.seats.find(s=>s.conn===c)}
function setOnline(id,v){
 const s=NET.seats[id];if(!s)return;s.online=v;
 if(S.G){const p=S.G.players[id];p.online=v;if(!v)p.downAt=Date.now();afterChange()}else broadcastLobby();
}
function hostConn(c){
 c.on("data",m=>hostMsg(c,m));
 const left=()=>{const s=seatOf(c);if(s&&s.conn===c&&s.online)setOnline(s.id,false)};
 c.on("close",left);c.on("error",left);
}
function hostMsg(c,m){
 if(!m||typeof m!=="object")return;
 if(m.t==="hello"){
  const nm=cleanName(m.name);
  if(!nm)return safeSend(c,{t:"err",msg:"ชื่อไม่ถูกต้อง",fatal:1});
  let s=NET.seats.find(x=>x.name.toLowerCase()===nm.toLowerCase());
  if(s){
   if(s.id===0)return safeSend(c,{t:"err",msg:"ชื่อนี้เป็นของโฮสต์",fatal:1});
   if(s.conn&&s.conn!==c&&s.online&&Date.now()-s.seen<12000)return safeSend(c,{t:"err",msg:"ชื่อนี้กำลังออนไลน์อยู่ (ถ้าเพิ่งหลุด รอสักครู่แล้วลองใหม่)",retry:1});
   if(s.conn&&s.conn!==c){try{s.conn.close()}catch(e){}}
  }else{
   if(S.G)return safeSend(c,{t:"err",msg:"เกมเริ่มแล้ว ไม่มีที่นั่งสำหรับชื่อนี้ (ต้องใช้ชื่อเดิมเพื่อกลับเข้าเกม)",fatal:1});
   if(NET.seats.length>=6)return safeSend(c,{t:"err",msg:"ห้องเต็ม (สูงสุด 6 คน)",fatal:1});
   s={id:NET.seats.length,name:nm,char:null,conn:null,online:false,seen:0};NET.seats.push(s);
  }
  s.conn=c;s.seen=Date.now();
  safeSend(c,{t:"welcome",id:s.id,code:NET.code});
  setOnline(s.id,true);
  if(S.G)safeSend(c,{t:"state",G:viewOf(S.G)});
  return;
 }
 const s=seatOf(c);if(!s)return;
 s.seen=Date.now();
 if(m.t==="ping")return safeSend(c,{t:"pong"});
 if(m.t==="pick"){
  if(S.G)return;
  if(!CH[m.char])return;
  if(NET.seats.some(x=>x!==s&&x.char===m.char))return safeSend(c,{t:"err",msg:"ตัวละครนี้ถูกเลือกแล้ว"});
  s.char=m.char;broadcastLobby();return;
 }
 if(m.t==="act"){
  if(!S.G)return;const a=m.a;
  if(!a||typeof a!=="object"||typeof a.aid!=="string")return safeSend(c,{t:"err",msg:"คำสั่งไม่ถูกต้อง"});
  if(NET.seen[a.aid])return;NET.seen[a.aid]=1;if(Object.keys(NET.seen).length>600)NET.seen={};
  const act={t:String(a.t),pid:s.id,k:a.k,to:a.to,rEng:a.rEng,rTool:a.rTool,swap:!!a.swap};
  const r=apply(S.G,act);
  if(!r.ok){safeSend(c,{t:"err",msg:r.msg});return}
  afterChange();
 }
}
function hostBeat(){
 const now=Date.now();
 NET.seats.forEach(s=>{if(s.id!==0&&s.online&&now-s.seen>12000)setOnline(s.id,false)});
 if(S.G)persist();
}
function hostCreate(){
 if(typeof Peer==="undefined"){netMsg("โหลดไลบรารี PeerJS ไม่สำเร็จ (ต้องออนไลน์เพื่อโหลดจาก CDN) — ออนไลน์ P2P ใช้งานไม่ได้ตอนนี้",1);return}
 const name=cleanName($("inName").value);if(!name){netMsg("กรุณาใส่ชื่อผู้เล่นก่อน",1);return}
 let code=$("inRoom").value.toUpperCase().replace(/[^A-Z0-9]/g,"");if(code.length!==5)code=rndCode();
 closeNet();const sid=NET.sid;NET.isHost=true;NET.code=code;NET.name=name;saveSet({name:name});
 netMsg("กำลังเชื่อมต่อเซิร์ฟเวอร์สัญญาณ...");$("roomCode").textContent="";
 let peer;try{peer=new Peer("lastbeacon-"+code,peerOpts())}catch(e){netMsg("สร้างการเชื่อมต่อไม่ได้: "+e.message,1);return}
 NET.peer=peer;
 peer.on("open",()=>{
  if(sid!==NET.sid)return;
  let sv2=null;try{sv2=JSON.parse(localStorage.getItem("lb_host")||"null")}catch(e){}
  if(sv2&&sv2.code===code&&sv2.G&&!sv2.G.over&&sv2.G.players[0]&&sv2.G.players[0].name.toLowerCase()===name.toLowerCase()){
   S.G=sv2.G;S.mode="host";S.myId=0;
   NET.seats=S.G.players.map(p=>({id:p.id,name:p.name,char:p.char,conn:null,online:p.id===0,seen:Date.now()}));
   S.G.players.forEach(p=>{p.online=p.id===0;p.downAt=Date.now()});
   S.gid=null;go("scr-game");afterChange();toast("กู้เกมเดิมของห้อง "+code+" แล้ว รอผู้เล่นเข้าด้วยชื่อเดิม");
  }else{
   S.G=null;S.mode="host";S.myId=0;NET.seats=[{id:0,name:name,char:null,conn:null,online:true,seen:Date.now()}];
   netMsg("ห้องพร้อมแล้ว — ส่งรหัสหรือลิงก์ให้เพื่อน (การเชื่อมต่อจริงขึ้นกับเครือข่ายของแต่ละคน)");broadcastLobby();
  }
  NET.hb=setInterval(hostBeat,3000);
 });
 peer.on("connection",c=>{if(sid===NET.sid)hostConn(c)});
 peer.on("error",e=>{if(sid!==NET.sid)return;
  if(e.type==="unavailable-id")netMsg("รหัสห้องนี้ถูกใช้อยู่ ลองรหัสอื่นหรือปล่อยว่างให้สุ่มใหม่",1);
  else netMsg("ข้อผิดพลาดเครือข่าย: "+e.type+" — ตรวจสอบอินเทอร์เน็ต/เซิร์ฟเวอร์สัญญาณ แล้วกดสร้างห้องใหม่",1)});
 peer.on("disconnected",()=>{if(sid!==NET.sid)return;netMsg("หลุดจากเซิร์ฟเวอร์สัญญาณ กำลังเชื่อมใหม่ (ผู้เล่นที่เชื่อมอยู่แล้วยังเล่นต่อได้)",1);try{peer.reconnect()}catch(e){}});
}
function scheduleRejoin(sid){
 clearTimeout(NET.rt);
 if(NET.isHost||sid!==NET.sid)return;
 if(NET.tries>=6){netMsg("เชื่อมต่อโฮสต์ไม่สำเร็จหลายครั้ง — โฮสต์อาจปิดเกม (ไม่มีการย้ายโฮสต์) หรือเครือข่ายบล็อก P2P ตรง กดเข้าร่วมห้องเพื่อลองใหม่",1);return}
 NET.tries++;NET.rt=setTimeout(()=>clientJoin(true),4000);
}
function clientJoin(silent){
 if(typeof Peer==="undefined"){netMsg("โหลดไลบรารี PeerJS ไม่สำเร็จ (ต้องออนไลน์) — ออนไลน์ P2P ใช้งานไม่ได้ตอนนี้",1);return}
 const name=cleanName(silent?NET.name:$("inName").value),code=(silent?NET.code:$("inRoom").value).toUpperCase().replace(/[^A-Z0-9]/g,"");
 if(!name||code.length!==5){netMsg("ใส่ชื่อผู้เล่นและรหัสห้อง 5 ตัวอักษร",1);return}
 const tries=silent?NET.tries:0;closeNet();const sid=NET.sid;NET.tries=tries;
 NET.isHost=false;NET.code=code;NET.name=name;saveSet({name:name});
 netMsg("กำลังเชื่อมต่อห้อง "+code+" ...");
 let peer;try{peer=new Peer(peerOpts())}catch(e){netMsg("สร้างการเชื่อมต่อไม่ได้: "+e.message,1);return}
 NET.peer=peer;
 peer.on("error",e=>{if(sid!==NET.sid)return;
  netMsg(e.type==="peer-unavailable"?"ไม่พบห้องนี้ (รหัสผิด หรือโฮสต์ยังไม่ออนไลน์)":"ข้อผิดพลาดเครือข่าย: "+e.type+" (เครือข่ายอาจบล็อก P2P ตรง ต้องใช้ TURN หรือเซิร์ฟเวอร์สัญญาณมีปัญหา)",1);
  scheduleRejoin(sid)});
 peer.on("open",()=>{
  if(sid!==NET.sid)return;
  const c=peer.connect("lastbeacon-"+code,{reliable:true});NET.hostConn=c;
  NET.jt=setTimeout(()=>{if(sid!==NET.sid||NET.joined)return;netMsg("หมดเวลาเชื่อมต่อ — เครือข่ายอาจบล็อก P2P ตรง (ต้องใช้ TURN) รหัสผิด หรือโฮสต์ออฟไลน์",1);scheduleRejoin(sid)},15000);
  c.on("open",()=>{if(sid===NET.sid)safeSend(c,{t:"hello",name:name})});
  c.on("data",m=>{if(sid===NET.sid)clientMsg(m)});
  c.on("close",()=>{if(sid===NET.sid)clientLost()});
  c.on("error",()=>{if(sid===NET.sid)clientLost()});
 });
 NET.hb=setInterval(()=>{if(sid!==NET.sid)return;if(NET.hostConn&&NET.hostConn.open)safeSend(NET.hostConn,{t:"ping"});if(NET.joined&&Date.now()-NET.lastHost>15000)clientLost()},3000);
}
function clientLost(){
 const sid=NET.sid;if(NET.lostSid===sid)return;NET.lostSid=sid;NET.joined=false;
 netMsg("ขาดการเชื่อมต่อกับโฮสต์ — กำลังลองเชื่อมใหม่ (หากโฮสต์ปิดเกม จะไม่มีการย้ายโฮสต์)",1);
 if(S.G)render();scheduleRejoin(sid);
}
function clientMsg(m){
 if(!m||typeof m!=="object")return;
 NET.lastHost=Date.now();
 if(m.t==="welcome"){NET.joined=true;NET.tries=0;clearTimeout(NET.jt);NET.lostSid=-1;S.myId=m.id;S.mode="client";netMsg("เชื่อมต่อสำเร็จ — ห้อง "+NET.code);$("roomCode").textContent=NET.code;if(!S.G){S.G=null;go("scr-lobby")}}
 else if(m.t==="lobby"){NET.lobby=m.seats||[];renderLobby()}
 else if(m.t==="state"){S.mode="client";S.G=m.G;if(S.screen!=="scr-game"&&S.screen!=="scr-end")go("scr-game");render()}
 else if(m.t==="err"){toast(m.msg);netMsg(m.msg,1);if(m.fatal)NET.tries=99;else if(m.retry)scheduleRejoin(NET.sid)}
}
function hostStartGame(){
 if(!NET.isHost)return;
 if(NET.seats.length<2){toast("ต้องมีผู้เล่นอย่างน้อย 2 คน");return}
 if(NET.seats.some(s=>!s.char)){toast("ทุกคนต้องเลือกตัวละคร");return}
 if(NET.seats.some(s=>!s.online)){toast("มีผู้เล่นออฟไลน์ — รอให้กลับมาก่อน");return}
 S.G=newGame({players:NET.seats.map(s=>({name:s.name,char:s.char,bot:false})),diff:"normal"});
 S.G.players.forEach((p,i)=>{p.online=NET.seats[i].online});
 S.mode="host";S.myId=0;S.gid=null;go("scr-game");afterChange();
}

