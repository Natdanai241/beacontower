 $("btnEndMenu").onclick=()=>{if(S.mode==="host"||S.mode==="client")leaveNet();clearTimeout(S.bt);S.mode=null;go("scr-menu")};
 $("btnErrClose").onclick=()=>$("errPanel").classList.remove("show");
 const q=new URLSearchParams(location.search),room=(q.get("room")||"").toUpperCase().replace(/[^A-Z0-9]/g,"").slice(0,5);
 if(room){$("inRoom").value=room;go("scr-lobby");renderLobby();netMsg("ลิงก์เชิญ: ใส่ชื่อของคุณแล้วกด เข้าร่วมห้อง")}
